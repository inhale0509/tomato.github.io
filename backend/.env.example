# backend/.env 로 복사해서 실제 값 채우기 (backend/.env는 절대 git에 커밋하지 말 것)

# Anthropic API 키 (콘솔에서 발급) — 이 키는 항상 서버에만 있어야 하고 프론트엔드 코드에는 절대 넣지 않는다.
ANTHROPIC_API_KEY=

# 사용할 모델 id. 정확한 최신 모델 id는 Anthropic 콘솔/문서에서 확인해서 채울 것.
CLAUDE_MODEL=claude-sonnet-5

# 백엔드 서버 포트
PORT=3001

# CORS 허용 출처 — GitHub Pages로 배포된 프론트 도메인 (예: https://inhale0509.github.io)
FRONTEND_ORIGIN=http://localhost:5500
